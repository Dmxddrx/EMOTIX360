<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="EMOTIX360.App.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PageBackground">#0B111B</Color>
            <Color x:Key="Surface">#121D2A</Color>
            <Color x:Key="SurfaceRaised">#1A2939</Color>
            <Color x:Key="BorderColor">#26384B</Color>
            <Color x:Key="Accent">#5CE0C0</Color>
            <Color x:Key="AccentMuted">#193E3C</Color>
            <Color x:Key="PrimaryText">#F1F5F9</Color>
            <Color x:Key="SecondaryText">#91A2B5</Color>
            <Color x:Key="MutedText">#617488</Color>
            <Color x:Key="Warning">#E8B66B</Color>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="18,13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

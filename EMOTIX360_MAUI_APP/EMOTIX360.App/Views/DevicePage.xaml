<?xml version="1.0" encoding="UTF-8" ?>

<ContentPage
    x:Class="EMOTIX360.App.Views.DevicePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Device"
    BackgroundColor="#0B111B"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="22,26,22,30"
            Spacing="22">

            <VerticalStackLayout Spacing="5">

                <Label
                    Text="DEVICE"
                    FontSize="11"
                    CharacterSpacing="2"
                    FontAttributes="Bold"
                    TextColor="#5796FF" />

                <Label
                    Text="Bluetooth"
                    FontSize="32"
                    FontAttributes="Bold"
                    TextColor="#F2F5FC" />

                <Label
                    Text="Connect your phone to EMOTIX360."
                    FontSize="14"
                    TextColor="#8999AF" />

            </VerticalStackLayout>


            <!-- CONNECTION STATUS -->
            <Border
                BackgroundColor="#142135"
                Stroke="#263C58"
                StrokeThickness="1"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout
                    Spacing="12"
                    HorizontalOptions="Center">

                    <Border
                        WidthRequest="76"
                        HeightRequest="76"
                        BackgroundColor="#1D3454"
                        Stroke="#365782"
                        StrokeThickness="1"
                        HorizontalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>

                        <Label
                            Text="BLE"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="#78A8FF"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                    </Border>

                    <Label
                        Text="Not connected"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="#F2F5FC"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Your phone is not currently connected to an EMOTIX360 device."
                        FontSize="13"
                        TextColor="#92A2B8"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </Border>


            <!-- EXPECTED DEVICE -->
            <VerticalStackLayout Spacing="12">

                <Label
                    Text="YOUR DEVICE"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="1.2"
                    TextColor="#DFE7F3" />

                <Border
                    BackgroundColor="#121C2B"
                    Stroke="#26364A"
                    StrokeThickness="1"
                    Padding="17">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="EMOTIX360"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="#F2F5FC" />

                            <Label
                                Text="ESP32-S3 BLE device"
                                FontSize="12"
                                TextColor="#8999AF" />

                            <Label
                                Text="Expected device name"
                                FontSize="10"
                                TextColor="#667991" />

                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            BackgroundColor="#263C58"
                            Padding="10,7"
                            VerticalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <Label
                                Text="KNOWN"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#A9C8FF" />

                        </Border>

                    </Grid>

                </Border>

            </VerticalStackLayout>


            <!-- SCANNING PLACEHOLDER -->
            <Border
                BackgroundColor="#121C2B"
                Stroke="#26364A"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="17" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="NEARBY DEVICES"
                        FontSize="12"
                        FontAttributes="Bold"
                        CharacterSpacing="1"
                        TextColor="#DFE7F3" />

                    <Label
                        Text="Device discovery is not enabled yet."
                        FontSize="13"
                        TextColor="#8999AF" />

                    <Label
                        Text="Bluetooth scanning and connection management will be implemented in the next development stage."
                        FontSize="12"
                        TextColor="#71839B"
                        LineHeight="1.35" />

                </VerticalStackLayout>

            </Border>


            <Label
                Text="Make sure your EMOTIX360 is powered on and Bluetooth advertising is active."
                FontSize="11"
                TextColor="#677B94"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>

<?xml version="1.0" encoding="UTF-8" ?>

<ContentPage
    x:Class="EMOTIX360.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Settings"
    BackgroundColor="#0B111B"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="22,26,22,30"
            Spacing="22">

            <VerticalStackLayout Spacing="5">

                <Label
                    Text="PREFERENCES"
                    FontSize="11"
                    CharacterSpacing="2"
                    FontAttributes="Bold"
                    TextColor="#5796FF" />

                <Label
                    Text="Settings"
                    FontSize="32"
                    FontAttributes="Bold"
                    TextColor="#F2F5FC" />

                <Label
                    Text="Configure your EMOTIX360 application."
                    FontSize="14"
                    TextColor="#8999AF" />

            </VerticalStackLayout>


            <!-- APPEARANCE -->
            <VerticalStackLayout Spacing="12">

                <Label
                    Text="APPEARANCE"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    TextColor="#DFE7F3" />

                <Border
                    BackgroundColor="#121C2B"
                    Stroke="#26364A"
                    StrokeThickness="1"
                    Padding="17">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="4">

                            <Label
                                Text="Application theme"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#F2F5FC" />

                            <Label
                                Text="EMOTIX360 dark appearance"
                                FontSize="11"
                                TextColor="#8999AF" />

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="1"
                            Text="DARK"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="#78A8FF"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>

            </VerticalStackLayout>


            <!-- DEVICE INFORMATION -->
            <VerticalStackLayout Spacing="12">

                <Label
                    Text="DEVICE"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    TextColor="#DFE7F3" />

                <Border
                    BackgroundColor="#121C2B"
                    Stroke="#26364A"
                    StrokeThickness="1"
                    Padding="17">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="16">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Device name"
                                FontSize="13"
                                TextColor="#93A4BA" />

                            <Label
                                Grid.Column="1"
                                Text="EMOTIX360"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#F2F5FC" />

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Color="#26364A" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Hardware"
                                FontSize="13"
                                TextColor="#93A4BA" />

                            <Label
                                Grid.Column="1"
                                Text="ESP32-S3"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#F2F5FC" />

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Color="#26364A" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Connection"
                                FontSize="13"
                                TextColor="#93A4BA" />

                            <Label
                                Grid.Column="1"
                                Text="Bluetooth LE"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#F2F5FC" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>


            <!-- APPLICATION INFORMATION -->
            <VerticalStackLayout Spacing="12">

                <Label
                    Text="APPLICATION"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    TextColor="#DFE7F3" />

                <Border
                    BackgroundColor="#121C2B"
                    Stroke="#26364A"
                    StrokeThickness="1"
                    Padding="17">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="13">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Application"
                                FontSize="13"
                                TextColor="#93A4BA" />

                            <Label
                                Grid.Column="1"
                                Text="EMOTIX360"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#F2F5FC" />

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Color="#26364A" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Version"
                                FontSize="13"
                                TextColor="#93A4BA" />

                            <Label
                                Grid.Column="1"
                                Text="1.0"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#F2F5FC" />

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Color="#26364A" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Platform"
                                FontSize="13"
                                TextColor="#93A4BA" />

                            <Label
                                Grid.Column="1"
                                Text="Android"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#F2F5FC" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>


            <!-- FOOTER -->
            <VerticalStackLayout
                Spacing="5"
                HorizontalOptions="Center"
                Margin="0,10,0,0">

                <Label
                    Text="EMOTIX360"
                    FontSize="13"
                    FontAttributes="Bold"
                    CharacterSpacing="2"
                    TextColor="#60748F"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Designed for intelligent interaction."
                    FontSize="10"
                    TextColor="#53657C"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
